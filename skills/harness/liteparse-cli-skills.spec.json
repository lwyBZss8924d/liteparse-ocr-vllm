{
  "name": "liteparse-cli-skills",
  "source_root": "skills/liteparse-cli-tools-custom-collection",
  "installed_root": "$HOME/.agents/skills/liteparse-cli-tools-custom-collection",
  "sync_mode": "copy_on_validated_sync",
  "forbidden_repo_autoload_roots": [
    ".agents/skills/liteparse-cli-tools-custom-collection",
    ".codex/skills/liteparse-cli-tools-custom-collection"
  ],
  "expected_skill_files": [
    "SKILL.md",
    "agents/openai.yaml",
    "liteparse-cli-discovery/SKILL.md",
    "liteparse-cli-discovery/agents/openai.yaml",
    "liteparse-cli-pipelines/SKILL.md",
    "liteparse-cli-pipelines/agents/openai.yaml",
    "liteparse-ocr-server/SKILL.md",
    "liteparse-ocr-server/agents/openai.yaml"
  ],
  "cli": {
    "binary": "lit",
    "required_commands": [
      "codex-ocr",
      "codex-ocr-server",
      "codex-ocr-pipeline",
      "glmocr-ocr-server",
      "glmocr-pipeline",
      "lmstudio-ocr-server",
      "lmstudio-ocr",
      "lmstudio-ocr-pipeline",
      "lmstudio-openai-adapter"
    ],
    "command_help_options": {
      "codex-ocr": [
        "--codex-home",
        "--backend",
        "--reasoning-effort",
        "--model",
        "--include-raw",
        "--strict-bbox"
      ],
      "codex-ocr-server": [
        "--codex-home",
        "--backend",
        "--reasoning-effort",
        "--model",
        "--include-raw",
        "--strict-bbox"
      ],
      "codex-ocr-pipeline": [
        "--codex-home",
        "--backend",
        "--reasoning-effort",
        "--model",
        "--include-raw",
        "--strict-bbox",
        "--batch-mode",
        "--target-pages",
        "--dpi",
        "--no-save"
      ]
    }
  },
  "required_terms": [
    "POST /ocr",
    "POST /ocr/analyze",
    "results[].text",
    "results[].bbox",
    "results[].confidence",
    "LITEPARSE_CODEX_HOME",
    "LITEPARSE_CODEX_OCR_MODEL",
    "LITEPARSE_CODEX_OCR_REASONING",
    "codex_bboxes_are_model_inferred",
    "$HOME/.codex-test",
    "final/document.md",
    "final/document.json",
    "model_provider",
    "wire_api = \"responses\""
  ],
  "docs": {
    "required_files": [
      "AGENTS.md",
      "OCR_API_SPEC.md",
      "README.md",
      "cli/README.md",
      "ocr/README.md",
      "ocr/glmocr/README.md",
      "src/engines/ocr/README.md",
      "docs/src/content/docs/liteparse/cli-reference.md",
      "docs/src/content/docs/liteparse/guides/ocr.md",
      ".github/workflows/ci.yml",
      "Dockerfile.glmocr-offline",
      "docker/glmocr-offline/entrypoint.sh",
      "docker/codex-ocr-server/README.md",
      "docker/codex-ocr-server/config.local-open-responses.example.toml",
      "scripts/smoke-offline-npm-tgz.mjs",
      "scripts/validate-glmocr-offline-gpu.sh"
    ],
    "required_terms": {
      "AGENTS.md": [
        "skills/liteparse-cli-tools-custom-collection",
        "@zzwz/liteparse-vllm",
        "custom/vllm-ocr-main",
        "src/engines/ocr/codex.ts",
        "src/engines/ocr/codex-server.ts",
        "skills/harness/liteparse-cli-skills.spec.json",
        "npm run validate:agent-skills:source",
        "npm run validate:agent-skills",
        "npm run sync:agent-skills:dry-run",
        "npm run smoke:offline-npm-tgz",
        "Do not describe the GLM-OCR SDK dependency path as GPU-only",
        "wire_api = \"responses\"",
        "Dockerfile.glmocr-offline"
      ],
      "OCR_API_SPEC.md": [
        "POST /ocr",
        "POST /ocr/analyze",
        "results[].text",
        "results[].bbox",
        "results[].confidence",
        "codex_bboxes_are_model_inferred",
        "default Docker OCR profile starts `codex-ocr-server`"
      ],
      "README.md": [
        "glmocr-pipeline",
        "codex-ocr-pipeline",
        "final/document.md",
        "final/document.json",
        "LITEPARSE_CODEX_HOME",
        "GLM-OCR SDK pipeline itself can run without this image",
        "default Docker profile is `codex`",
        "wire_api = \"responses\"",
        "smoke:offline-npm-tgz",
        "scripts/validate-glmocr-offline-gpu.sh",
        "explicit unverified gate",
        "GLM-OCR model",
        "MIT licensed",
        "PP-DocLayoutV3",
        "Apache-2.0"
      ],
      "cli/README.md": [
        "lit codex-ocr-server",
        "lit codex-ocr-pipeline",
        "lit glmocr-pipeline",
        "lit lmstudio-openai-adapter",
        "POST /ocr/analyze",
        "wire_api = \"responses\""
      ],
      "ocr/README.md": [
        "POST /ocr/analyze",
        "LITEPARSE_CODEX_HOME",
        "SDK/`uv run server.py` path is not GPU-only",
        "Docker defaults to the `codex` OCR profile",
        "$HOME/.codex-test"
      ],
      "ocr/glmocr/README.md": [
        "Optional vLLM offline Docker runtime",
        "can run through `uv run server.py` without this Docker image"
      ],
      "src/engines/ocr/README.md": [
        "POST /ocr/analyze",
        "codex_bboxes_are_model_inferred",
        "--strict-bbox",
        "wire_api = \"responses\""
      ],
      "docs/src/content/docs/liteparse/cli-reference.md": [
        "lit codex-ocr-pipeline",
        "lit glmocr-pipeline",
        "POST /ocr/analyze"
      ],
      "docs/src/content/docs/liteparse/guides/ocr.md": [
        "lit codex-ocr-pipeline",
        "final/document.md",
        "final/document.json",
        "codex_bboxes_are_model_inferred",
        "wire_api = \"responses\""
      ],
      ".github/workflows/ci.yml": [
        "custom/vllm-ocr-main",
        "validate:agent-skills:source",
        "Dockerfile.glmocr-offline",
        "smoke:offline-npm-tgz"
      ],
      "Dockerfile.glmocr-offline": [
        "LITEPARSE_OCR_PROFILE=codex",
        "LITEPARSE_CODEX_HOME=/codex-home"
      ],
      "docker/glmocr-offline/entrypoint.sh": [
        "codex-ocr-server",
        "LITEPARSE_CODEX_OCR_BACKEND",
        "LITEPARSE_CODEX_OCR_STRICT_BBOX"
      ],
      "docker/codex-ocr-server/README.md": [
        "codex-ocr-server",
        "LITEPARSE_CODEX_HOME",
        "model_provider",
        "wire_api = \"responses\"",
        "Open Responses"
      ],
      "docker/codex-ocr-server/config.local-open-responses.example.toml": [
        "#:schema https://developers.openai.com/codex/config-schema.json",
        "model_provider = \"local-open-responses\"",
        "wire_api = \"responses\""
      ],
      "scripts/smoke-offline-npm-tgz.mjs": [
        "--network=none",
        "node:24-trixie-slim",
        "LITEPARSE_OFFLINE_TGZ_CONTAINER_PACK",
        "Hello LiteParse"
      ],
      "scripts/validate-glmocr-offline-gpu.sh": [
        "--gpus all",
        "--network=none",
        "docker load",
        "POST /ocr",
        "lit parse",
        "HF_HUB_OFFLINE=1",
        "TRANSFORMERS_OFFLINE=1"
      ]
    }
  },
  "projection_targets": [
    "$HOME/.agents/skills/liteparse-cli-tools-custom-collection",
    "$HOME/.codex/skills/liteparse-cli-tools-custom-collection",
    "$HOME/.codex-test/skills/liteparse-cli-tools-custom-collection",
    "$HOME/.claude/skills/liteparse-cli-tools-custom-collection",
    "$HOME/forge/skills/liteparse-cli-tools-custom-collection",
    "$HOME/.gemini/skills/liteparse-cli-tools-custom-collection"
  ]
}
