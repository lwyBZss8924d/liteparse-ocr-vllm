{
  "name": "@arthur/liteparse-vllm",
  "version": "1.5.3-custom.0",
  "description": "Open-source PDF parsing with spatial text extraction and OCR processing with Custom Codex-OCR and GML-OCR Servers",
  "type": "module",
  "main": "./dist/src/lib.js",
  "types": "./dist/src/lib.d.ts",
  "bin": {
    "lit": "./dist/src/index.js",
    "liteparse": "./dist/src/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/src/lib.d.ts",
      "import": "./dist/src/lib.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src/vendor/pdfjs",
    "README.md",
    "LICENSE",
    "OCR_API_SPEC.md",
    "cli/README.md",
    "ocr/README.md",
    "ocr/glmocr/README.md",
    "ocr/glmocr/pyproject.toml",
    "ocr/glmocr/server.py",
    "ocr/glmocr/uv.lock",
    "ocr/lmstudio/README.md",
    "src/engines/ocr/README.md"
  ],
  "bundledDependencies": [
    "@hyzyla/pdfium",
    "@openai/codex-sdk",
    "axios",
    "busboy",
    "commander",
    "file-type",
    "form-data",
    "p-limit",
    "sharp",
    "tesseract.js",
    "unified",
    "zod"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "clean:windows": "powershell -Command \"if (Test-Path dist) { Remove-Item -Recurse -Force dist }\"",
    "chmod-bin": "chmod +x dist/src/index.js",
    "chmod-bin:windows": "powershell -Command \"if (Test-Path dist/src/index.js) { Write-Output 'bin ready' }\"",
    "build": "npm run clean && tsc -p tsconfig.build.json && npm run chmod-bin && npm run copy-vendor",
    "build:windows": "npm run clean:windows && tsc -p tsconfig.build.json && npm run chmod-bin:windows && npm run copy-vendor:windows",
    "copy-vendor": "mkdir -p dist/src/vendor && cp -r src/vendor/pdfjs dist/src/vendor/",
    "copy-vendor:windows": "powershell -Command \"New-Item -ItemType Directory -Path dist/src/vendor -Force; Copy-Item -Recurse src/vendor/pdfjs dist/src/vendor/\"",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src cli",
    "lint:fix": "eslint src cli --fix",
    "format": "prettier --write \"src/**/*.ts\" \"cli/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"cli/**/*.ts\"",
    "validate:agent-skills": "node scripts/validate-liteparse-cli-skills.mjs",
    "validate:agent-skills:source": "node scripts/validate-liteparse-cli-skills.mjs --source-only",
    "sync:agent-skills": "node scripts/sync-liteparse-cli-skills.mjs --json",
    "sync:agent-skills:dry-run": "node scripts/sync-liteparse-cli-skills.mjs --dry-run --json",
    "docs:api": "bash scripts/generate-api-docs.sh",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "npm run build && changeset publish"
  },
  "dependencies": {
    "@hyzyla/pdfium": "^2.1.9",
    "@openai/codex-sdk": "0.128.0",
    "axios": "^1.7.0",
    "busboy": "^1.6.0",
    "commander": "^12.0.0",
    "file-type": "^21.3.3",
    "form-data": "^4.0.0",
    "p-limit": "^7.3.0",
    "sharp": "^0.34.5",
    "tesseract.js": "^7.0.0",
    "unified": "^11.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.6.0",
    "@changesets/cli": "^2.30.0",
    "@eslint/js": "^10.0.1",
    "@types/busboy": "^1.5.4",
    "@types/node": "^22.0.0",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "prettier": "^3.8.1",
    "typedoc": "^0.28.17",
    "typedoc-plugin-markdown": "^4.10.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.56.0",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "pdf",
    "parser",
    "ocr",
    "text-extraction",
    "pdf-to-text",
    "document-parsing"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/run-llama/liteparse.git"
  },
  "bugs": {
    "url": "https://github.com/run-llama/liteparse/issues"
  },
  "homepage": "https://github.com/run-llama/liteparse#readme",
  "author": "LlamaIndex",
  "license": "Apache-2.0"
}
